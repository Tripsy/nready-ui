NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_APP_DEBUG=true
NEXT_PUBLIC_APP_URL="http://nready-ui.test"
NEXT_PUBLIC_APP_NAME="NReady"
NEXT_PUBLIC_TIMEZONE="Europe/Bucharest"

REMOTE_API_URL="http://nready-api.test:3000"
NEXT_PUBLIC_REMOTE_API_WS_URL="ws://nready-api.test:3000/ws"
NEXT_PUBLIC_REMOTE_API_WS_RECONNECT_DELAY=3000

# Sent as `x-api-key` on every call to REMOTE_API_URL; must appear in the backend's
# CLIENT_API_KEYS. Server-only on purpose - a NEXT_PUBLIC_ key would ship to the browser.
REMOTE_API_KEY="change-me"

ALLOWED_ORIGINS="http://nready-ui.test"

NEXT_PUBLIC_LANGUAGE_DEFAULT=en
NEXT_PUBLIC_LANGUAGE_SUPPORTED=en,ro
NEXT_PUBLIC_LANGUAGE_COOKIE="app-language"
NEXT_PUBLIC_LANGUAGE_COOKIE_MAX_AGE=365

SESSION_TOKEN=session-token
# Seconds. Keep in sync with the backend's AUTH_JWT_EXPIRES_IN.
SESSION_MAX_AGE=86400
# Seconds of remaining life below which the session cookie is refreshed.
# Keep in sync with the backend's AUTH_JWT_REFRESH_EXPIRES_IN.
SESSION_REFRESH_THRESHOLD=28800

REDIS_HOST=host.docker.internal
REDIS_PASSWORD=
REDIS_PORT=6379
# Both projects share one Redis instance/db - this namespaces their keys apart.
REDIS_KEY_PREFIX=nready-ui
CACHE_TTL=0
# Seconds to cache the backend `/account/me` lookup the proxy runs on every request. 0 disables it.
CACHE_AUTH_TTL=30

# This are not in use at the moment - see README.md OR proxy.ts for more info
RATE_LIMIT_WINDOW=60
MAX_REQUESTS=100
NEXT_PUBLIC_APP_CURRENCY=RON
NEXT_PUBLIC_APP_VAT_RATE=24

# Serve the API reference pages at /api-docs (opt-in; must agree with
# the backend API_DOCS_ENABLED, which decides if there is anything to render)
NEXT_PUBLIC_API_DOCS_ENABLED=true

# Empty disables Sentry entirely (no init, no instrumentation) - see src/config/sentry.setup.ts
NEXT_PUBLIC_SENTRY_DSN=
# Fraction of transactions sampled for performance data. Errors are always sent.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Build-time only, for uploading source maps so stack traces are not minified.
SENTRY_ORG=
# The project slug, not the numeric id - @sentry/cli resolves the upload target by slug.
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

IMAGE_STORAGE="local" # local OR s3
IMAGE_SAVE_PATH="public/uploads"
IMAGE_VIEW_PATH="/uploads"

AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Social sign-in. Public by design - the browser needs these to build the provider's
# authorize URL. The matching client *secrets* live in the nready-api .env, which is what
# exchanges the authorization code. Leave a client id empty to hide that provider's button.
NEXT_PUBLIC_OAUTH_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_OAUTH_FACEBOOK_CLIENT_ID=
